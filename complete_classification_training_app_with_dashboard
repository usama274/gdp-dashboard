                    "Certificate_Status": "Not Issued",
                    "Certificate_Link": "",
                    "Due_Date": str(due_date),
                    "Completed_On": "",
                    "Progress_%": 0,
                    "Remarks": "Assigned by Admin.",
                    "Last_Updated": now(),
