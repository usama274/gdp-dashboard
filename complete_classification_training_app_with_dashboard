def main():
    st.set_page_config(page_title="Classification Society Training Platform", layout="wide")

    if not Path(DB_FILE).exists():
        create_database(reset=True)

    apply_frontend_theme()
    app_header()

    actor = login_sidebar()
    role_welcome_card(actor)

    st.sidebar.divider()
    if st.sidebar.button("Reset Excel Database"):
        create_database(reset=True)
        st.sidebar.success("Database recreated.")
        st.rerun()

    download_excel_button()

    role = actor["Role"]

    if role == "Management":
        page = st.sidebar.radio("Menu", ["Home", "Role Dashboard", "Dashboard", "Notifications"])
        if page == "Home":
            frontend_home(actor)
        elif page == "Role Dashboard":
            role_dashboard(actor)
        elif page == "Dashboard":
            management_view(actor)
        else:
            notification_view(actor)

    elif role == "Admin":
        page = st.sidebar.radio("Menu", ["Home", "Role Dashboard", "Admin Panel", "Management View", "Notifications"])
        if page == "Home":
            frontend_home(actor)
        elif page == "Role Dashboard":
            role_dashboard(actor)
        elif page == "Admin Panel":
            admin_view(actor)
        elif page == "Management View":
            management_view(actor)
        else:
            notification_view(actor)

    elif role == "Trainer":
        page = st.sidebar.radio("Menu", ["Home", "Role Dashboard", "Trainer Panel", "Notifications"])
        if page == "Home":
            frontend_home(actor)
        elif page == "Role Dashboard":
            role_dashboard(actor)
        elif page == "Trainer Panel":
            trainer_view(actor)
        else:
            notification_view(actor)

    elif role in ["Surveyor", "Plan Appraiser"]:
        page = st.sidebar.radio("Menu", ["Home", "Role Dashboard", "Training Portal"])
        if page == "Home":
            frontend_home(actor)
        elif page == "Role Dashboard":
            role_dashboard(actor)
        else:
            trainee_view(actor)

    else:
        st.error("Unknown role.")

    st.divider()
    with st.expander("Dashboard Sheet"):
        show_df(read_sheet("Dashboard"))

    with st.expander("Activity Log Sheet"):
        show_df(read_sheet("Activity_Log"))

if __name__ == "__main__":
    main()