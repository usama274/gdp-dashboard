def login_sidebar():
    st.sidebar.title("User Login")
    st.sidebar.caption("Select role/user to open the relevant dashboard and action panel.")

    staff = read_sheet("Staff")
    if staff.empty:
        st.sidebar.error("Staff database is empty.")
        st.stop()

    role_filter = st.sidebar.selectbox(
        "Filter by Role",
        ["All", "Management", "Admin", "Trainer", "Surveyor", "Plan Appraiser"]
    )

    view_staff = staff.copy()
    if role_filter != "All":
        view_staff = view_staff[view_staff["Role"] == role_filter]

    if view_staff.empty:
        st.sidebar.warning("No user found for this role.")
        st.stop()

    view_staff["Display"] = view_staff["Name"].astype(str) + " — " + view_staff["Role"].astype(str)
    selected = st.sidebar.selectbox("Select User", view_staff["Display"].tolist())
    actor = view_staff[view_staff["Display"] == selected].iloc[0].to_dict()

    st.sidebar.success(f"Logged in as: {actor['Role']}")
    st.sidebar.caption(actor["Email"])
    return actor



