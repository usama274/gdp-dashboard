def trainee_view(actor):
    st.header(f"{actor['Role']} Training Portal")
    action_panel("Trainee Working Area", "Complete assigned training activities, open materials, submit test and receive certificate after passing.")

    records = read_sheet("Training_Records")
    my_records = records[records["Staff_ID"] == actor["Staff_ID"]]

    if my_records.empty:
        st.warning("No training assigned yet.")
        return

    training_display = st.selectbox("My Training", my_records["Training_Title"] + " — " + my_records["Training_ID"])
    training_id = training_display.split(" — ")[-1]

    record = my_records[my_records["Training_ID"] == training_id].iloc[0]
    training = get_training(training_id)

    st.subheader("My Status")
    c1, c2, c3, c4, c5 = st.columns(5)
    c1.metric("Progress", f"{record['Progress_%']}%")
    c2.metric("Slides", record["Slides_Opened"])
    c3.metric("Video", record["Video_Opened"])
    c4.metric("Test", record["Test_Status"])
    c5.metric("Certificate", record["Certificate_Status"])

    st.subheader("Training Material")
    col1, col2, col3 = st.columns(3)

    with col1:
        st.write("Slides")
        st.code(training.get("Slides_Link", ""))
        if st.button("Open Slides / Mark Complete"):
            trainee_update(actor, training_id, "Slides_Opened", "Yes", "Slides opened.")

    with col2:
        st.write("Video")
        st.code(training.get("Video_Link", ""))
        if st.button("Open Video / Mark Complete"):
            trainee_update(actor, training_id, "Video_Opened", "Yes", "Video opened.")

    with col3:
        st.write("Recording")
        st.code(training.get("Recording_Link", ""))
        if st.button("Open Recording / Mark Complete"):
            records = read_sheet("Training_Records")
            mask = (records["Staff_ID"] == actor["Staff_ID"]) & (records["Training_ID"] == training_id)
            records.loc[mask, "Recording_Opened"] = "Yes"
            records.loc[mask, "Video_Opened"] = "Yes"
            records.loc[mask, "Live_Attendance"] = "Recording Viewed"
            records.loc[mask, "Remarks"] = "Recording viewed."
            records.loc[mask, "Last_Updated"] = now()
            save_sheet("Training_Records", records)

            log_activity("Recording Viewed", actor["Staff_ID"], actor["Name"], actor["Role"], staff_id=actor["Staff_ID"], training_id=training_id)
            refresh_training_records()
            st.success("Recording marked complete.")
            st.rerun()

    st.subheader("Test")
    passing_marks = int(record["Passing_Marks"]) if str(record["Passing_Marks"]).strip() else 75
    score = st.number_input("Score", 0, 100, 75)

    if st.button("Submit Test"):
        records = read_sheet("Training_Records")
        mask = (records["Staff_ID"] == actor["Staff_ID"]) & (records["Training_ID"] == training_id)

        result = "Passed" if score >= passing_marks else "Failed"
        records.loc[mask, "Score"] = score
        records.loc[mask, "Test_Status"] = result
        records.loc[mask, "Remarks"] = f"Test submitted. Score: {score}"
        records.loc[mask, "Last_Updated"] = now()
        save_sheet("Training_Records", records)

        log_activity("Test Submitted", actor["Staff_ID"], actor["Name"], actor["Role"], staff_id=actor["Staff_ID"], training_id=training_id, remarks=result)
        refresh_training_records()

        if result == "Passed":
            issue_certificate(actor, training_id, score)
            st.success("Passed. Certificate issued.")
        else:
            st.error("Failed. Certificate not issued.")

        st.rerun()

    st.subheader("My Complete Record")
    records = read_sheet("Training_Records")
    show_df(records[records["Staff_ID"] == actor["Staff_ID"]])

def trainee_update(actor, training_id, field, value, remarks):
    records = read_sheet("Training_Records")
    mask = (records["Staff_ID"] == actor["Staff_ID"]) & (records["Training_ID"] == training_id)

    records.loc[mask, field] = value
    records.loc[mask, "Remarks"] = remarks
    records.loc[mask, "Last_Updated"] = now()
    save_sheet("Training_Records", records)

    log_activity(
        field.replace("_", " "),
        actor["Staff_ID"],
        actor["Name"],
        actor["Role"],
        staff_id=actor["Staff_ID"],
        training_id=training_id,
        remarks=remarks,
    )
    refresh_training_records()
    st.success("Activity updated.")
    st.rerun()

