def trainer_view(actor):
    st.header("Trainer Panel")
    action_panel("Trainer Working Area", "Submit training materials, schedule sessions, generate notifications, mark attendance and save recordings.")

    trainings = read_sheet("Trainings")
    my_trainings = trainings[trainings["Trainer_ID"] == actor["Staff_ID"]]

    if my_trainings.empty:
        st.warning("No training assigned to this trainer.")
        return

    training_display = st.selectbox("Assigned Training", my_trainings["Training_Title"] + " — " + my_trainings["Training_ID"])
    training_id = training_display.split(" — ")[-1]
    training = my_trainings[my_trainings["Training_ID"] == training_id].iloc[0]

    tab1, tab2, tab3, tab4 = st.tabs(["Training Material", "Schedule & Notify", "Attendance & Recording", "Results"])

    with tab1:
        st.subheader("Update Training Material")
        with st.form("material_form"):
            slides = st.text_input("Slides Link", value=str(training.get("Slides_Link", "")))
            video = st.text_input("Video Link", value=str(training.get("Video_Link", "")))
            reference = st.text_input("Reference Link", value=str(training.get("Reference_Link", "")))
            passing = st.number_input("Passing Marks", 0, 100, int(training.get("Passing_Marks", 75)))
            submit = st.form_submit_button("Submit Material")

            if submit:
                if not require_allowed(actor["Role"], "update_training_fields"):
                    return

                all_trainings = read_sheet("Trainings")
                idx = all_trainings[all_trainings["Training_ID"] == training_id].index[0]

                all_trainings.at[idx, "Slides_Link"] = slides
                all_trainings.at[idx, "Video_Link"] = video
                all_trainings.at[idx, "Reference_Link"] = reference
                all_trainings.at[idx, "Passing_Marks"] = passing
                all_trainings.at[idx, "Submitted_By_Trainer"] = "Yes"
                all_trainings.at[idx, "Status"] = "Material Submitted"
                all_trainings.at[idx, "Last_Updated"] = now()
                save_sheet("Trainings", all_trainings)

                records = read_sheet("Training_Records")
                records.loc[records["Training_ID"] == training_id, "Passing_Marks"] = passing
                save_sheet("Training_Records", records)

                log_activity("Material Submitted", actor["Staff_ID"], actor["Name"], actor["Role"], training_id=training_id)
                st.success("Training material saved.")
                st.rerun()

    with tab2:
        st.subheader("Schedule & Notify")
        schedule_date = st.date_input("Schedule Date")
        schedule_time = st.text_input("Schedule Time", value="10:00 AM")
        meeting_link = st.text_input("Meeting Link", value=generate_meeting_link(training_id))

        if st.button("Submit Schedule & Generate Email Notifications"):
            if not require_allowed(actor["Role"], "submit_training_schedule"):
                return

            all_trainings = read_sheet("Trainings")
            idx = all_trainings[all_trainings["Training_ID"] == training_id].index[0]

            all_trainings.at[idx, "Schedule_Date"] = str(schedule_date)
            all_trainings.at[idx, "Schedule_Time"] = schedule_time
            all_trainings.at[idx, "Meeting_Link"] = meeting_link
            all_trainings.at[idx, "Status"] = "Scheduled"
            all_trainings.at[idx, "Last_Updated"] = now()
            save_sheet("Trainings", all_trainings)

            generate_notifications(training_id, actor)
            log_activity("Schedule Submitted", actor["Staff_ID"], actor["Name"], actor["Role"], training_id=training_id)
            st.success("Schedule saved and email notifications generated in Excel.")
            st.rerun()

        show_df(read_sheet("Notifications"))

    with tab3:
        st.subheader("Attendance & Recording")

        records = read_sheet("Training_Records")
        training_records = records[records["Training_ID"] == training_id]

        if training_records.empty:
            st.warning("No trainees assigned.")
        else:
            show_df(training_records[["Staff_ID", "Staff_Name", "Live_Attendance", "Status", "Progress_%"]])

            trainee_display = st.selectbox("Trainee", training_records["Staff_Name"] + " — " + training_records["Staff_ID"])
            selected_staff_id = trainee_display.split(" — ")[-1]
            attendance = st.selectbox("Attendance", ["Present", "Absent"])

            if st.button("Mark Attendance"):
                if not require_allowed(actor["Role"], "mark_attendance"):
                    return

                records = read_sheet("Training_Records")
                mask = (records["Training_ID"] == training_id) & (records["Staff_ID"] == selected_staff_id)
                records.loc[mask, "Live_Attendance"] = attendance
                records.loc[mask, "Remarks"] = f"Attendance marked: {attendance}"
                records.loc[mask, "Last_Updated"] = now()
                save_sheet("Training_Records", records)

                log_activity("Attendance Marked", actor["Staff_ID"], actor["Name"], actor["Role"], staff_id=selected_staff_id, training_id=training_id, remarks=attendance)
                refresh_training_records()
                st.success("Attendance saved.")
                st.rerun()

        recording_link = st.text_input("Recording Link")

        if st.button("Save Recording"):
            if not require_allowed(actor["Role"], "upload_recording"):
                return

            all_trainings = read_sheet("Trainings")
            idx = all_trainings[all_trainings["Training_ID"] == training_id].index[0]
            all_trainings.at[idx, "Recording_Link"] = recording_link
            all_trainings.at[idx, "Status"] = "Recorded"
            all_trainings.at[idx, "Last_Updated"] = now()
            save_sheet("Trainings", all_trainings)

            log_activity("Recording Saved", actor["Staff_ID"], actor["Name"], actor["Role"], training_id=training_id, remarks=recording_link)
            st.success("Recording link saved.")
            st.rerun()

    with tab4:
        st.subheader("Results")
        records = read_sheet("Training_Records")
        show_df(records[records["Training_ID"] == training_id])

