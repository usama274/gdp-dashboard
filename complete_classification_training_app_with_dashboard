def status_pill(status):
    status = str(status)
    if status in ["Completed", "Passed", "Issued", "Present", "Yes", "Sent"]:
        return f'<span class="success-pill">{status}</span>'
    if status in ["Pending", "Draft", "Scheduled", "Not Attempted", "No", "Generated", "Absent"]:
        return f'<span class="warning-pill">{status}</span>'
    return f'<span class="info-pill">{status}</span>'

