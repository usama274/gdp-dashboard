def admin_view(actor):
    st.header("Admin Panel")
    action_panel("Admin Working Area", "Create users, assign roles, create trainings, assign trainers and assign trainees. Every action updates the Excel database.")

    tab1, tab2, tab3, tab4 = st.tabs(["Staff & Roles", "Create Training", "Assign Trainees", "All Records"])

    with tab1:
        st.subheader("Staff & Role Assignment")
        show_df(read_sheet("Staff"))

        with st.form("staff_form"):
            staff_id = st.text_input("Staff ID", value=make_id("STF"))
            name = st.text_input("Name")
            role = st.selectbox("Role", ["Admin", "Management", "Trainer", "Surveyor", "Plan Appraiser"])
            department = st.text_input("Department")
            email = st.text_input("Email")
            save_btn = st.form_submit_button("Save Staff")

            if save_btn:
                if not require_allowed(actor["Role"], "manage_staff"):
                    return

                staff = read_sheet("Staff")
                new_row = {
                    "Staff_ID": staff_id,
                    "Name": name,
                    "Role": role,
                    "Department": department,
                    "Email": email,
                    "Status": "Active",
                }

                existing = staff[staff["Staff_ID"] == staff_id]
                if existing.empty:
                    staff = pd.concat([staff, pd.DataFrame([new_row])], ignore_index=True)
                    activity = "Staff Added"
                else:
                    idx = existing.index[0]
                    for key, value in new_row.items():
                        staff.at[idx, key] = value
                    activity = "Staff Updated"

                save_sheet("Staff", staff)
                log_activity(activity, actor["Staff_ID"], actor["Name"], actor["Role"], staff_id=staff_id, remarks=f"{name} as {role}")
                st.success("Staff saved.")
                st.rerun()

    with tab2:
        st.subheader("Create Training & Assign Trainer")

