[Unit]
Description=Streamlit application — Human Resource Development and Management
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/home/youruser/workspaces/gdp-dashboard
ExecStart=/usr/bin/env streamlit run /home/youruser/workspaces/gdp-dashboard/app.py --server.port 8502 --server.enableCORS false
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
